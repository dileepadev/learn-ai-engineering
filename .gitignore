# Secrets — API keys live here and must never be committed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv / virtualenvs
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local model / data artifacts (large, regenerable)
*.gguf
*.sqlite3
data/raw/

# Learning site (site/) — Node toolchain and build output.
# `src/generated/` is derived from phases/ on every build, so committing it would let a
# stale copy drift away from the lessons it claims to mirror.
site/node_modules/
site/dist/
site/.astro/
site/src/generated/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Claude Code local settings (project .mcp.json IS committed; local overrides are not)
.claude/settings.local.json
