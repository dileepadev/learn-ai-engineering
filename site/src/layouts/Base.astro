---
import "../styles/global.css";
import { href } from "../lib/href.ts";
import { loadPhases, countsBySlug } from "../lib/phaseList.ts";
import { PHASE_COUNTS_ID, serialiseCounts } from "../lib/phaseCounts.ts";
import { HeaderProgress } from "../components/HeaderProgress.tsx";
import { ThemeToggle } from "../components/ThemeToggle.tsx";
import { MobileNav } from "../components/MobileNav.tsx";
import { CommandPalette } from "../components/CommandPalette.tsx";
import { ShortcutsHelp } from "../components/ShortcutsHelp.tsx";
import { EDITION, NEXT_EDITION } from "../lib/edition.ts";

interface Props {
  title: string;
  description?: string;
  /** Which top-level link to mark current. Phase and lesson pages show place in the sidebar. */
  activePage?: string;
}

const { title, description, activePage } = Astro.props;

const phases = await loadPhases();
// Titles and links only. Counts travel once, in the JSON script below (see phaseCounts.ts).
const navPhases = phases.map(({ slug, number, title: phaseTitle }) => ({ slug, number, title: phaseTitle }));
const currentPath = Astro.url.pathname;

const fullTitle = title === "Learn AI Engineering" ? title : `${title} · Learn AI Engineering`;
const summary =
  description ?? "An interactive, build-first roadmap for modern AI engineering.";

// `from` is the width at which a link appears in the header; below it, it lives in the menu
// drawer. Full class names (not `${from}:block`) so Tailwind can see them at build time.
// "Progress" is not in this list: it is its own component and shows at every width, because
// being unable to find your progress was the problem it was added to solve.
const SHOW_FROM = { md: "md:block", lg: "lg:block" } as const;
const NAV_BEFORE_PROGRESS = [
  { label: "Dashboard", route: "/", page: "dashboard", from: "md" },
  { label: "Roadmap", route: "/#roadmap", page: "roadmap", from: "md" },
] as const;
const NAV_AFTER_PROGRESS = [
  // `lg`, not `md`: with the labelled Progress button, a 768px header has no room for it.
  { label: "Role", route: "/role", page: "role", from: "lg" },
  { label: "About", route: "/about", page: "about", from: "lg" },
] as const;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />

    <!--
      Theme must be resolved before first paint, or a learner with dark mode set sees a
      white flash on every navigation. This is the one script that has to be inline and
      render-blocking; it is deliberately tiny.
    -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("lai:theme");
        } catch {
          // Storage blocked: fall back to the system setting.
        }
        const dark =
          stored === "dark" ||
          (stored === null && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>

  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      Skip to content
    </a>

    <!-- Read by usePhaseCounts(). One copy per page instead of one per island. -->
    <script
      is:inline
      type="application/json"
      id={PHASE_COUNTS_ID}
      set:html={serialiseCounts(countsBySlug(phases))}
    />

    <header class="site-header sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-1 px-3 sm:gap-2 sm:px-6">
        <!--
          The header fits one row from 320px up (WCAG 1.4.10 reflow). Nothing is dropped
          to make that happen any more: below `md` the text links move into the menu drawer,
          and below `lg` so does the progress gauge. The menu button is hidden once the
          desktop sidebar takes over.
        -->
        <MobileNav client:idle phases={navPhases} currentPath={currentPath} />

        <a
          href={href("/")}
          class="flex items-center gap-2.5 rounded-md font-semibold tracking-tight transition-opacity hover:opacity-75"
        >
          <span
            class="grid size-8 place-items-center rounded-lg bg-accent text-sm font-bold text-accent-ink"
            aria-hidden="true">AI</span
          >
          <!--
            Below `sm` the mark is all that shows, so the name stays in the accessibility
            tree via sr-only instead of display:none, or the link would have no name.
          -->
          <span class="sr-only sm:not-sr-only">Learn AI Engineering</span>
          <span
            class="hidden rounded-full border border-line px-1.5 py-0.5 text-xs font-medium leading-none text-muted xl:inline"
            title={`The ${EDITION} edition of the roadmap`}>{EDITION}</span
          >
        </a>

        <nav class="ml-auto flex items-center gap-1 text-sm" aria-label="Main">
          {
            NAV_BEFORE_PROGRESS.map((link) => (
              <a
                href={href(link.route)}
                aria-current={activePage === link.page ? "page" : undefined}
                class:list={[
                  "hidden rounded-md px-3 py-1.5 transition-colors hover:bg-sunken hover:text-ink",
                  SHOW_FROM[link.from],
                  activePage === link.page ? "font-medium text-ink" : "text-muted",
                ]}
              >
                {link.label}
              </a>
            ))
          }
          <HeaderProgress client:idle current={activePage === "progress"} />
          {
            NAV_AFTER_PROGRESS.map((link) => (
              <a
                href={href(link.route)}
                aria-current={activePage === link.page ? "page" : undefined}
                class:list={[
                  "hidden rounded-md px-3 py-1.5 transition-colors hover:bg-sunken hover:text-ink",
                  SHOW_FROM[link.from],
                  activePage === link.page ? "font-medium text-ink" : "text-muted",
                ]}
              >
                {link.label}
              </a>
            ))
          }
          <span class="mx-1 hidden h-5 w-px bg-line md:block" aria-hidden="true"></span>
          <CommandPalette client:idle />
          <ThemeToggle client:idle />
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line py-8 text-sm text-faint">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-4 px-4 sm:px-6 md:flex-row md:items-center md:justify-between"
      >
        <div class="space-y-1">
          <p>
            Lessons and drills are generated from
            <code class="rounded bg-sunken px-1 py-0.5 text-[0.9em]">phases/</code> in the repo.
          </p>
          <p>{EDITION} edition, finishing 31 December. The {NEXT_EDITION} edition will be a new release.</p>
        </div>
        <!--
          A <nav>, not a <p>: the shortcuts island renders a <dialog>, and a <p> may only hold
          inline content. The HTML parser closes the paragraph when it meets <dialog> and
          moves the dialog out, so React's hydration finds a DOM that differs from what the
          server sent and throws (React error #418) on every page.
        -->
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Footer">
          <a class="transition-colors hover:text-ink" href={href("/role")}>The role</a>
          <a class="transition-colors hover:text-ink" href={href("/about")}>About</a>
          <a class="transition-colors hover:text-ink" href={href("/progress")}>Your progress</a>
          <ShortcutsHelp client:idle />
          <a
            class="transition-colors hover:text-ink"
            href="https://github.com/dileepadev/learn-ai-engineering"
            rel="noreferrer">Source on GitHub</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
