---
import Base from "../layouts/Base.astro";
import { Dashboard } from "../components/Dashboard.tsx";
import { loadPhases } from "../lib/phaseList.ts";

const phases = await loadPhases();
---

<Base title="Learn AI Engineering" activePage="dashboard">
  <!--
    `client:load` rather than `client:idle`: this island *is* the page, and every number
    on it comes from localStorage. Deferring it would show a fully empty dashboard first.
  -->
  <Dashboard client:load phases={phases} />
</Base>
