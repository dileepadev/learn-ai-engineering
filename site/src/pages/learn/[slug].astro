---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { LessonHeader, LessonNav } from "../../components/LessonHeader.tsx";
import { DrillRunner } from "../../components/DrillRunner.tsx";
import { LessonChecks, type CheckData } from "../../components/Check.tsx";
import type { TocItem } from "../../components/OnThisPage.tsx";
import { topicByLessonSlug } from "../../lib/curriculum.ts";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({ params: { slug: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const topic = topicByLessonSlug(lesson.id);

// Checks are authored per lesson and keyed `<lesson-slug>--<n>`; keep their order.
const checks: CheckData[] = (await getCollection("checks"))
  .filter((entry) => entry.data.lesson === lesson.id)
  .sort((a, b) => a.data.index - b.data.index)
  .map((entry) => entry.data as CheckData);

// Lessons are shorter and nest more than phase docs, so h3s earn a place too. The checks
// and drills are islands, outside the markdown, so they are appended by hand.
const toc: TocItem[] = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
if (checks.length > 0) toc.push({ depth: 2, slug: "checks", text: "Check yourself" });
if (topic) toc.push({ depth: 2, slug: "drills", text: "Drills" });
---

<Docs title={lesson.data.title} toc={toc}>
  {topic && <LessonHeader slot="header" client:load topicId={topic.id} lessonSlug={lesson.id} />}

  <article class="prose mt-10">
    <Content />
  </article>

  <!--
    Checks sit between the lesson and the drills on purpose: they catch the specific
    misconceptions the lesson just warned about, while it is still fresh, and before the
    drills assume you absorbed them.
  -->
  {checks.length > 0 && <LessonChecks client:visible checks={checks} />}

  <!--
    `client:visible` on the runner: it pulls in CodeMirror and, on first run, ~10MB of
    Pyodide. Loading that for someone who opened the page to re-read the lesson would be
    wasteful, so it waits until the drills actually scroll into view. The component then
    warms Pyodide on idle, so the wait is absorbed while they finish reading.
  -->
  {topic && <DrillRunner client:visible topicId={topic.id} />}

  <!-- `client:idle`, not `client:visible`: it also binds ←/→, which must work from the top. -->
  {topic && <LessonNav client:idle topicId={topic.id} />}
</Docs>
