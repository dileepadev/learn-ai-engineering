---
import Base from "../layouts/Base.astro";
import { ProgressManager } from "../components/ProgressManager.tsx";
import { loadPhases } from "../lib/phaseList.ts";

// Totals come from the docs at build time, so they move when a criterion or part is added
// instead of going stale as a hand-typed number.
const phases = await loadPhases();
---

<Base
  title="Your progress"
  description="See how far along you are in each phase, and export, import, or reset your saved learning progress."
  activePage="progress"
>
  <ProgressManager client:load phases={phases} />
</Base>
