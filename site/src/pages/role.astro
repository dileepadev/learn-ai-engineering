---
import { getCollection, render } from "astro:content";
import Docs from "../layouts/Docs.astro";
import { Breadcrumbs } from "../components/Breadcrumbs.tsx";
import { EDITION } from "../lib/edition.ts";

// Rendered from `phases/the-role.md`, like every other page's content. Failing the build
// here is deliberate: a silently empty page is worse than a red CI run.
const [entry] = await getCollection("role");
if (!entry) {
  throw new Error("phases/the-role.md is missing, so the /role page has nothing to render.");
}
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
---

<Docs
  title="The AI Engineer role"
  description="What an AI Engineer does in 2026, what job postings ask for, how interviews run, and what it pays: the research behind this roadmap."
  activePage="role"
  toc={toc}
>
  <header slot="header">
    <!-- Static: no client directive, so it renders to plain HTML and ships no JavaScript. -->
    <Breadcrumbs items={[{ label: "Dashboard", route: "/" }, { label: "The role" }]} />
    <p class="mt-5 font-mono text-sm text-accent">{EDITION} research</p>
    <h1 class="mt-1.5 text-3xl font-bold tracking-tight sm:text-4xl">{entry.data.title}</h1>
  </header>

  <article class="prose mt-8">
    <Content />
  </article>
</Docs>
